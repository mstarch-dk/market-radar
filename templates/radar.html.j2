<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Market Radar</title>
<script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>
<style>
:root {
  color-scheme: light;
  --bg: #f4f3ef; --surface: #fcfcfb; --border: #e2e1dc;
  --ink: #0b0b0b; --ink-2: #52514e; --ink-3: #8a8985;
  --accent: #2a78d6; --pos: #0b7a3b; --neg: #c2312f;
  --on: #008300; --off: #e34948; --neutral: #8a8985;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --bg: #121211; --surface: #1a1a19; --border: #33332f;
    --ink: #ffffff; --ink-2: #c3c2b7; --ink-3: #8f8e86;
    --accent: #3987e5; --pos: #4cc27a; --neg: #ef7471;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --bg: #121211; --surface: #1a1a19; --border: #33332f;
  --ink: #ffffff; --ink-2: #c3c2b7; --ink-3: #8f8e86;
  --accent: #3987e5; --pos: #4cc27a; --neg: #ef7471;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 14px/1.45 Inter, "Segoe UI", system-ui, sans-serif; }
header { padding: 20px 24px 0; }
h1 { font-size: 22px; margin: 0 0 4px; }
.sub { color: var(--ink-2); }
nav { display: flex; gap: 4px; padding: 16px 24px 0; border-bottom: 1px solid var(--border); overflow-x: auto; }
nav button { background: none; border: 0; padding: 10px 14px; font: inherit; color: var(--ink-2); cursor: pointer; border-bottom: 2px solid transparent; white-space: nowrap; }
nav button.active { color: var(--ink); border-bottom-color: var(--accent); font-weight: 600; }
main { padding: 20px 24px 48px; max-width: 1400px; }
section { display: none; } section.active { display: block; }
h2 { font-size: 17px; margin: 28px 0 10px; } h2:first-child { margin-top: 0; }
.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(460px, 1fr)); gap: 16px; }
.grid > * { min-width: 0; }
.card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px; }
.chart { background: #fcfcfb; border-radius: 10px; border: 1px solid var(--border); padding: 4px; }
.hero { display: flex; gap: 24px; align-items: center; flex-wrap: wrap; }
.hero .big { font-size: 32px; font-weight: 700; }
.pill { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 12px; border: 1px solid var(--border); color: var(--ink-2); white-space: nowrap; }
.st-risk-on { color: var(--on); border-color: var(--on); } .st-risk-off { color: var(--off); border-color: var(--off); }
.st-risk-on::before { content: "▲ "; } .st-risk-off::before { content: "▼ "; } .st-neutral::before { content: "● "; }
.q-Leading { color: #008300; } .q-Weakening { color: #a86f00; } .q-Lagging { color: #c2312f; } .q-Improving { color: #2a78d6; }
.tbl-wrap { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; }
th, td { padding: 6px 10px; text-align: right; border-bottom: 1px solid var(--border); white-space: nowrap; }
th { color: var(--ink-2); font-weight: 600; font-size: 12px; cursor: pointer; user-select: none; position: sticky; top: 0; background: var(--surface); }
th:first-child, td:first-child, td.l, th.l { text-align: left; }
tr:hover td { background: color-mix(in srgb, var(--accent) 6%, transparent); }
.pos { color: var(--pos); } .neg { color: var(--neg); } .muted { color: var(--ink-3); }
.new { color: var(--accent); font-weight: 600; font-size: 11px; }
.note { color: var(--ink-2); font-size: 13px; max-width: 900px; }
.flag { margin-right: 4px; }
details.why { margin-top: 4px; font-size: 12px; color: var(--ink-2); } details.why summary { cursor: pointer; color: var(--ink-3); }
details.why ul { margin: 4px 0 0; padding-left: 4px; list-style: none; white-space: normal; min-width: 360px; }
@media (max-width: 600px) { header, nav, main { padding-left: 16px; padding-right: 16px; } .grid { grid-template-columns: 1fr; } }
</style>
</head>
<body>
<header>
  <h1>Market Radar</h1>
  <div class="sub">Data as of {{ asof }} · generated {{ generated }} · benchmark MSCI ACWI</div>
</header>
<nav>
  <button data-tab="regime" class="active">Regime</button>
  <button data-tab="rotation">Sector rotation</button>
  <button data-tab="themes">Themes &amp; ETFs</button>
  <button data-tab="momentum">Momentum leaders</button>
  <button data-tab="positioning">Positioning &amp; cycle</button>
  <button data-tab="me">My holdings &amp; watchlist</button>
  <button data-tab="data">Data notes</button>
</nav>
<main>

{% macro quad(q) %}<span class="q-{{ q }}">{{ q }}</span>{% endmacro %}
{% macro chg(v) %}{% if v is none %}<span class="muted">new</span>{% elif v > 0 %}<span class="pos">▲{{ v }}</span>{% elif v < 0 %}<span class="neg">▼{{ -v }}</span>{% else %}<span class="muted">–</span>{% endif %}{% endmacro %}
{% macro pc(v, d=1) %}<td class="{{ v|sign }}" data-v="{{ v if v is not none else '' }}">{{ v|pct(d) }}</td>{% endmacro %}

<!-- REGIME -->
<section id="regime" class="active">
  <div class="card hero">
    <div><div class="sub">Overall reading</div><div class="big">{{ overall.label }}</div></div>
    <div class="sub">{{ overall.on }} risk-on · {{ overall.off }} risk-off · {{ overall.neutral }} neutral/informational</div>
  </div>
  <h2>Indicators</h2>
  <div class="card tbl-wrap"><table>
    <thead><tr><th class="l">Indicator</th><th>Reading</th><th class="l">Signal</th><th class="l">Context</th></tr></thead>
    <tbody>{% for i in indicators %}
      <tr><td>{{ i.name }}</td><td>{{ i.value }}</td><td class="l"><span class="pill st-{{ i.status }}">{{ i.status }}</span></td><td class="l muted">{{ i.note }}</td></tr>
    {% endfor %}</tbody></table></div>
  <h2>Charts</h2>
  <div class="grid">{% for c in regime_charts %}<div class="chart">{{ c|safe }}</div>{% endfor %}</div>
</section>

<!-- ROTATION -->
<section id="rotation">
  <p class="note">The rotation graph plots each ETF's <b>relative trend</b> vs ACWI (x) against its <b>acceleration</b> (y).
  Rotation usually runs clockwise: Improving → Leading → Weakening → Lagging. Names moving from <b>Improving into Leading</b> are typical early momentum candidates.
  Rank change is compared with the snapshot from {{ rotation_prev or "– (no earlier snapshot yet)" }}.</p>
  {% for key in ["us_sectors", "eu_sectors", "regions"] %}
    <h2>{{ etf_groups[key] }}</h2>
    {% set local = key in rrg_local_charts %}
    {% if local %}<div class="grid"><div class="chart">{{ rrg_charts[key]|safe }}</div><div class="chart">{{ rrg_local_charts[key]|safe }}</div></div><div style="height:16px"></div>{% endif %}
    <div class="{{ '' if local else 'grid' }}">
      {% if not local %}<div class="chart">{{ rrg_charts[key]|safe }}</div>{% endif %}
      <div class="card tbl-wrap"><table class="sortable">
        <thead><tr><th class="l">Name</th><th>#</th><th>Δ rank</th><th class="l">Quadrant</th>{% if local %}<th class="l">vs home mkt</th>{% endif %}<th>Rel 1m</th><th>Rel 3m</th><th>Rel 6m</th><th>Abs 3m</th><th>&gt;200d</th></tr></thead>
        <tbody>{% for r in group_tables[key] %}
          <tr><td title="{{ r.ticker }}">{{ r.name }} <span class="muted">{{ r.ticker }}</span></td><td data-v="{{ r.rank }}">{{ r.rank }}</td>
          <td data-v="{{ r.rank_change if r.rank_change is not none else '' }}">{{ chg(r.rank_change) }}</td><td class="l">{{ quad(r.quadrant) }}</td>
          {% if local %}<td class="l">{{ quad(r.quadrant_local or "n/a") }}</td>{% endif %}
          {{ pc(r.rel_r1m) }}{{ pc(r.rel_r3m) }}{{ pc(r.rel_r6m) }}{{ pc(r.r3m) }}<td>{{ "✓" if r.above200 else "✗" }}</td></tr>
        {% endfor %}</tbody></table></div>
    </div>
  {% endfor %}
</section>

<!-- THEMES -->
<section id="themes">
  <p class="note">Themes are measured with liquid US-listed ETFs. Use the <b>UCITS</b> column for something you can actually buy as a Danish investor, and verify it on justETF.
  <b>Positive list</b> (SKAT): <i>yes</i> means lager taxation as share income in frie midler, and the ETF can be held on an aktiesparekonto (17% lager). <i>no</i> means it's taxed as capital income in frie midler, which is usually less favourable, and it isn't eligible for the ASK. Prefer a positive-list alternative.
  The ASK taxes everything at 17% lager, so it's a natural home for 1–6-month momentum trades in stocks and positive-list ETFs. Confirm current rules on skat.dk.
  {% if not positive_list_loaded %}<br><span class="muted">Positive list not loaded. Put SKAT's list in imports/positivliste.xlsx and add <code>isin:</code> to ETFs in universe.yaml.</span>
  {% else %}<br><span class="muted">Checked against SKAT's {{ positive_list_year }} list. Search Saxo or Danske by ISIN to find the exact share class.</span>{% endif %}</p>
  <div class="grid">
    <div class="chart">{{ rrg_charts["themes"]|safe }}</div>
    <div class="card tbl-wrap"><table class="sortable">
      <thead><tr><th class="l">Theme</th><th>#</th><th>Δ rank</th><th class="l">Quadrant</th><th>Rel 1m</th><th>Rel 3m</th><th>Rel 6m</th><th>&gt;200d</th><th class="l">UCITS alternative</th><th class="l">ISIN</th><th class="l">Positive list {{ positive_list_year or "" }}</th></tr></thead>
      <tbody>{% for r in group_tables["themes"] %}
        <tr><td>{{ r.name }} <span class="muted">{{ r.ticker }}</span></td><td data-v="{{ r.rank }}">{{ r.rank }}</td>
        <td data-v="{{ r.rank_change if r.rank_change is not none else '' }}">{{ chg(r.rank_change) }}</td><td class="l">{{ quad(r.quadrant) }}</td>
        {{ pc(r.rel_r1m) }}{{ pc(r.rel_r3m) }}{{ pc(r.rel_r6m) }}<td>{{ "✓" if r.above200 else "✗" }}</td>
        <td class="l">{{ r.ucits_name or "–" }} {% if r.ucits %}<span class="muted">{{ r.ucits }}</span>{% endif %}</td>
        <td class="l">{{ r.isin or "–" }}</td>
        <td class="l">{% if r.positive_list == "yes" %}<span class="pill st-risk-on">yes</span>{% elif r.positive_list == "no" %}<span class="pill st-risk-off">no</span>{% else %}<span class="muted">?</span>{% endif %}</td></tr>
      {% endfor %}</tbody></table></div>
  </div>
</section>

<!-- MOMENTUM -->
<section id="momentum">
  <p class="note">The score (0–100) is the average percentile, within each region, of 12-1-month, 6-month and 3-month returns. "Trend" means price above the 200-day average and the 50-day above the 200-day.
  <span class="new">NEW</span> marks entries that weren't in the top {{ top_n }} at the snapshot from {{ momentum_prev or "– (no earlier snapshot yet)" }}.
  Momentum is a starting point for research, not a buy list. Check the story behind each move.</p>
  {% for region, rows in momentum_tables.items() %}
    <h2>{{ region_labels[region] }}</h2>
    {% if clusters[region] %}<p class="note"><b>Clusters in the top {{ top_n }}:</b>
      {% for c in clusters[region] %}{{ c.name }} <span class="muted">({{ c.level }})</span> {{ c.count }} names vs ~{{ c.expected }} expected{% if c.new %}, <span class="new">{{ c.new }} NEW</span>{% endif %}{{ "; " if not loop.last }}{% endfor %}</p>{% endif %}
    {% if dropped[region] %}<p class="note muted">Dropped out of top {{ top_n }}: {{ dropped[region]|join(", ") }}</p>{% endif %}
    <div class="card tbl-wrap"><table class="sortable">
      <thead><tr><th class="l">Company</th><th class="l">Industry</th><th>Score</th><th>1m</th><th>3m</th><th>6m</th><th>12-1m</th><th>From 52w high</th><th>Vol 20d/120d</th><th>Trend</th></tr></thead>
      <tbody>{% for r in rows %}
        <tr><td>{{ r.name }} <span class="muted">{{ r.ticker }}</span> {% if r.new %}<span class="new">NEW</span>{% endif %}</td><td class="l muted" title="{{ r.sector }}">{{ r.industry or "–" }}</td><td data-v="{{ r.score }}">{{ r.score|num(0) }}</td>
        {{ pc(r.r1m) }}{{ pc(r.r3m) }}{{ pc(r.r6m) }}{{ pc(r.r12_1) }}{{ pc(r.from_high) }}
        <td data-v="{{ r.vol_surge }}">{{ r.vol_surge|num(2) }}×</td><td>{{ "✓" if r.trend_ok else "✗" }}</td></tr>
      {% endfor %}</tbody></table></div>
  {% endfor %}
</section>

<!-- POSITIONING & CYCLE -->
<section id="positioning">
  <p class="note">Data that doesn't come from prices, so it can lead or confirm what the rotation and momentum tabs show. Sources: FactSet Earnings Insight (weekly), OECD Composite Leading Indicators (monthly, about 2 months' lag) and the CFTC Commitments of Traders (weekly; Tuesday positions published on Friday).</p>

  <h2>Earnings revisions (S&amp;P 500, FactSet)</h2>
  {% if factset %}
  <div class="card">
    <div class="hero">
      <div><div class="sub">{{ factset.quarter or "Current quarter" }} growth estimate</div><div class="big">{{ factset.growth_now|num(1) }}%</div>
        <div class="sub">{{ factset.growth_start|num(1) }}% at quarter start</div></div>
      <div><div class="sub">Forward P/E</div><div class="big">{{ factset.fwd_pe|num(1) }}</div>
        <div class="sub">5y avg {{ factset.fwd_pe_5y|num(1) }} · 10y avg {{ factset.fwd_pe_10y|num(1) }}</div></div>
      <div><div class="sub">EPS guidance</div><div class="big"><span class="pos">+{{ factset.guidance_pos|num(0) }}</span> / <span class="neg">−{{ factset.guidance_neg|num(0) }}</span></div>
        <div class="sub">positive / negative</div></div>
      <div><div class="sub">Next calendar year growth</div><div class="big">{{ factset.cy_next_growth|num(1) }}%</div></div>
    </div>
    <p class="note">Sectors with upward revisions: <b>{{ factset.rev_up_sectors or "–" }}</b>. Downward revisions: <b>{{ factset.rev_down_sectors or "–" }}</b>.
    <span class="muted">Report {{ factset.report_date }}. The full key pages are saved in data/factset_latest.txt.</span></p>
  </div>
  {% else %}<p class="note muted">No FactSet data yet. Run <code>radar update</code>.</p>{% endif %}

  <h2>Leading indicators (OECD CLI)</h2>
  {% if cli %}
  <div class="card tbl-wrap"><table>
    <thead><tr><th class="l">Area</th><th>CLI</th><th>3m change</th><th class="l">Phase</th><th>As of</th></tr></thead>
    <tbody>{% for r in cli %}
      <tr><td>{{ r.label }}</td><td>{{ r.cli|num(2) }}</td><td class="{{ r.chg_3m|sign }}">{{ "%+.2f"|format(r.chg_3m) }}</td>
      <td class="l"><span class="pill {{ 'st-risk-on' if r.phase == 'Expansion' else 'st-risk-off' if r.phase == 'Contraction' else 'st-neutral' }}">{{ r.phase }}</span></td><td>{{ r.asof[:7] }}</td></tr>
    {% endfor %}</tbody></table></div>
  <p class="note muted">100 = long-term trend. Expansion: above 100 and rising. Slowdown: above 100 and falling. Contraction: below 100 and falling. Recovery: below 100 and rising.</p>
  {% else %}<p class="note muted">No OECD data yet.</p>{% endif %}

  <h2>Futures positioning (CFTC)</h2>
  {% if cot %}
  <div class="card tbl-wrap"><table class="sortable">
    <thead><tr><th class="l">Market</th><th class="l">Trader group</th><th>Net % of OI</th><th>4w change</th><th>3y percentile</th><th class="l">Flag</th><th>As of</th></tr></thead>
    <tbody>{% for r in cot %}
      <tr><td>{{ r.market }}</td><td class="l">{{ r.group }}</td><td data-v="{{ r.net_pct_oi }}">{{ "%+.1f"|format(r.net_pct_oi) }}%</td>
      <td class="{{ r.chg_4w|sign }}" data-v="{{ r.chg_4w if r.chg_4w is not none else '' }}">{{ "–" if r.chg_4w is none else "%+.1f"|format(r.chg_4w) }}</td>
      <td data-v="{{ r.percentile }}">{{ r.percentile|num(0) }}</td>
      <td class="l">{% if r.flag %}<span class="pill flag">{{ r.flag }}</span>{% endif %}</td><td>{{ r.asof }}</td></tr>
    {% endfor %}</tbody></table></div>
  <p class="note muted">Net position (long − short) as a % of open interest, ranked against the last 3 years. Asset managers are slow, trend-following money. Leveraged funds (hedge funds) and managed money (CTAs) are fast money; their extremes tend to be contrarian. A "3y high" or "3y low" flag means the reading is in the top or bottom 10% of its own 3-year range (a 3y low can still be net long). That isn't a timing signal on its own, but it tells you which way a reversal would hurt most.</p>
  {% else %}<p class="note muted">No CFTC data yet.</p>{% endif %}
</section>

<!-- ME -->
<section id="me">
  {% if not me %}
    <p class="note">No holdings yet. Export your Yahoo Finance portfolio to CSV and run <code>radar import-yahoo &lt;file.csv&gt;</code>, or add tickers to <code>watchlist:</code> in config/universe.yaml.</p>
  {% else %}
  <p class="note">The score is each name's momentum percentile compared with the whole stock universe. "Since buy" is the open position's total return <b>in DKK</b>, including currency moves and dividends (gross, treated as reinvested), using the average-cost method.
  "ACWI (DKK)" is a <b>shadow position</b>: the same DKK amounts invested in ACWI on the same dates, with sells removing the same fraction. It answers "would the index have done better with this money?"
  "Since sell" shows how the stock has moved after your last sale, which is useful for reviewing exits.</p>
  {% for status, title in [("holding", "Holdings"), ("watch", "Watchlist"), ("sold", "Sold positions")] %}
  {% set rows = me|selectattr("status", "equalto", status)|list %}
  {% if rows %}
  <h2>{{ title }} ({{ rows|length }})</h2>
  <div class="card tbl-wrap"><table class="sortable">
    <thead><tr><th class="l">Name</th><th>Score</th><th>1m</th><th>3m</th><th>Rel 3m</th><th>6m</th><th>From high</th>
      {% if status == "holding" %}<th>Since buy (DKK)</th><th>ACWI (DKK)</th><th>Stop</th><th>Target</th>{% elif status == "sold" %}<th>Sold</th><th>Since sell</th>{% endif %}<th class="l">Flags</th></tr></thead>
    <tbody>{% for r in rows %}
      <tr><td>{{ r.name or r.symbol }} <span class="muted">{{ r.symbol }}</span></td><td data-v="{{ r.score if r.score is not none else '' }}">{{ r.score|num(0) }}</td>
      {{ pc(r.r1m) }}{{ pc(r.r3m) }}{{ pc(r.rel_r3m) }}{{ pc(r.r6m) }}{{ pc(r.from_high) }}
      {% if status == "holding" %}{{ pc(r.since_buy) }}{{ pc(r.bench_since_buy) }}{% set lv = r.levels %}
      {% if lv %}<td data-v="{{ lv.stop_pct }}">{{ lv.stop|num }} <span class="muted">{{ lv.stop_pct|pct }}</span></td>
      <td data-v="{{ lv.tp_pct if lv.tp_pct is not none else '' }}">{% if lv.take_profit is not none %}{{ lv.take_profit|num }} <span class="muted">{{ lv.tp_pct|pct }}</span>{% else %}–{% endif %}</td>
      {% else %}<td class="muted">–</td><td class="muted">–</td>{% endif %}{% elif status == "sold" %}<td>{{ r.last_sell_date or "–" }}</td>{{ pc(r.since_sell) }}{% endif %}
      <td class="l">{% for f in r.flags %}<span class="pill flag">{{ f }}</span>{% endfor %}{% if status == "holding" and r.levels %}{% for f in r.levels.flags %}<span class="pill st-risk-off">{{ f }}</span>{% endfor %}
        <details class="why"><summary>why (k {{ r.levels.k|num(2) }})</summary><ul>{% for x in r.levels.reasons %}
          <li><span class="{{ 'neg' if x.effect < 0 else 'pos' if x.effect > 0 else 'muted' }}">{{ '▼' if x.effect < 0 else '▲' if x.effect > 0 else '•' }}</span> <b>{{ x.signal }}</b>: {{ x.detail }}</li>{% endfor %}
          {% set a = r.levels.analyst %}{% if a and a.target_mean is defined and a.target_mean is not none %}<li class="muted">Analysts ({{ a.fetched }}): {{ a.rec_key or "?" }}, {{ a.n_analysts|num(0) }} opinions, targets {{ a.target_low|num }}–{{ a.target_high|num }}, mean {{ a.target_mean|num }} ({{ a.upside|pct }})</li>{% endif %}
        </ul></details>{% endif %}</td></tr>
    {% endfor %}</tbody></table></div>
  {% if status == "holding" %}<p class="note muted">Stop and target are a mechanical rule, not advice. Stop = highest close since entry − k × ATR(14), where k starts at 3 and each signal (▲ more room, ▼ tighter) moves it: momentum score, 50/200-day trend, extension above the 50-day, the radar's macro regime and analyst consensus. Target = the lower of 2 × the stop width (k × ATR) above the price and the analysts' mean target (needs at least 5 analysts). Broad index funds get no levels. Thresholds live in config/settings.yaml (<code>stops:</code>).</p>{% endif %}
  {% endif %}
  {% endfor %}
  {% endif %}
</section>

<!-- DATA -->
<section id="data">
  <p class="note">Prices come from Yahoo Finance via yfinance (unofficial, adjusted closes) and macro series from FRED. Returns are in each instrument's listing currency.
  The Europe and Nordic stock lists are curated large-cap proxies; edit them in config/universe.yaml.</p>
  <h2>Stale or missing tickers ({{ stale|length }})</h2>
  <p class="note">{% if stale %}{{ stale|join(", ") }}<br><span class="muted">No price in the last 7 days. The ticker may be wrong or delisted, so fix it in universe.yaml.</span>{% else %}None.{% endif %}</p>
</section>
</main>
<script>
document.querySelectorAll("nav button").forEach(b => b.addEventListener("click", () => {
  document.querySelectorAll("nav button, section").forEach(e => e.classList.remove("active"));
  b.classList.add("active");
  const s = document.getElementById(b.dataset.tab); s.classList.add("active");
  s.querySelectorAll(".js-plotly-plot").forEach(p => Plotly.Plots.resize(p));
  try { localStorage.setItem("radar-tab", b.dataset.tab); } catch (e) {}
}));
try { const t = localStorage.getItem("radar-tab"); if (t) document.querySelector(`nav button[data-tab="${t}"]`)?.click(); } catch (e) {}
document.querySelectorAll("table.sortable th").forEach((th, idx) => th.addEventListener("click", () => {
  const tbody = th.closest("table").tBodies[0], asc = th.dataset.asc !== "1";
  th.closest("tr").querySelectorAll("th").forEach(h => delete h.dataset.asc); th.dataset.asc = asc ? "1" : "0";
  const key = td => { const v = td.dataset.v; return v !== undefined && v !== "" && !isNaN(+v) ? +v : td.textContent.trim().toLowerCase(); };
  [...tbody.rows].sort((a, b) => { const x = key(a.cells[idx]), y = key(b.cells[idx]);
    if (x === y) return 0; if (x === "" ) return 1; if (y === "") return -1; return (x < y ? -1 : 1) * (asc ? 1 : -1); })
    .forEach(r => tbody.appendChild(r));
}));
</script>
</body>
</html>
