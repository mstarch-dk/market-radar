.venv/
__pycache__/
/reports/

# local data: prices and caches are re-downloadable; rank snapshots (data/snapshots/) build up with each run
/data/

# personal holdings stay local
/imports/*
!/imports/README.md
!/imports/positivliste.xlsx

# personal reading notes (may quote paid sources such as Bloomberg); local only (the /market-brief skill reads them)
/notes/

# portable mode (src/radar/paths.py): data kept beside the program; the marketing demo writes one into .demo/
/portable.json

# your own edits from the web app (portfolios, watchlist, views): local only; `radar bundle-holdings` carries them to another machine
/userdata/

# ticker comparisons written by `radar info A B --out` / the /compare skill (may hold personal data with --personal)
/exports/

# your briefs, research memos and decision journal: they name your holdings and decisions
/briefs/*
/research/
/journal/

# release zips built by scripts/build_release_zip.py
dist-release/

# demo copy of the app for the marketing screenshots (scripts/marketing.py workspace)
.demo/

# marketing screenshots: rebuilt by scripts/marketing.py shots on every edition; only the PDF is committed
marketing/site/img/

# ruff, mypy, import-linter and coverage caches
.ruff_cache/
.mypy_cache/
.import_linter_cache/
.coverage
.hypothesis/
coverage.xml
